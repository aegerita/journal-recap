{
	"name": "journal-recap",
	"version": "1.0.3",
	"description": "Recap your journal entries with AI generated summaries.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node scripts/test.mjs",
		"check:release": "node scripts/check-release.mjs",
		"check": "npm test && npm run lint && npm run build && npm run check:release"
	},
	"keywords": [],
	"author": "Jenny Tai",
	"license": "0-BSD",
	"engines": {
		"node": ">=22.13.0"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^24.19.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.0.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"obsidian": "$obsidian"
		}
	}
}
